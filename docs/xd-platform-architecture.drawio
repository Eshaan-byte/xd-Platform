        <mxCell id="flow1" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=#e8f5e9;strokeColor=#a5d6a7;rounded=1;spacingLeft=8;spacingTop=4;spacingRight=8;" value="&lt;b&gt;Upload Flow:&lt;/b&gt;&lt;br&gt;1. Admin uploads game file (ZIP/HTML)&lt;br&gt;2. Backend gets presigned S3 URL&lt;br&gt;3. File uploaded directly to Cloud Storage&lt;br&gt;4. Game metadata saved to MongoDB" vertex="1">
          <mxGeometry height="80" width="260" x="30" y="430" as="geometry" />
        </mxCell>
        <mxCell id="flow2" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=#e3f2fd;strokeColor=#90caf9;rounded=1;spacingLeft=8;spacingTop=4;spacingRight=8;" value="&lt;b&gt;Download Flow:&lt;/b&gt;&lt;br&gt;1. User purchases game (Stripe checkout)&lt;br&gt;2. Order saved to MongoDB&lt;br&gt;3. User requests download&lt;br&gt;4. Backend verifies purchase &amp; returns&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;presigned S3 download URL (expires)" vertex="1">
          <mxGeometry height="95" width="280" x="30" y="530" as="geometry" />
        </mxCell>
        <mxCell id="flow3" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=#fce4ec;strokeColor=#ef9a9a;rounded=1;spacingLeft=8;spacingTop=4;spacingRight=8;" value="&lt;b&gt;Auth Flow:&lt;/b&gt;&lt;br&gt;1. User registers (email + password)&lt;br&gt;2. Password hashed with bcrypt&lt;br&gt;3. JWT token issued on login&lt;br&gt;4. Token sent in Authorization header&lt;br&gt;5. Admin role check for admin routes" vertex="1">
          <mxGeometry height="95" width="260" x="30" y="645" as="geometry" />
