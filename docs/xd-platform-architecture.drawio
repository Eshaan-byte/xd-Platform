          <mxGeometry x="540" y="535" width="500" height="25" as="geometry"/>
        </mxCell>

        <!-- Auth Service -->
        <mxCell id="svc-auth" value="&lt;b&gt;Auth Service&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /auth/register&lt;br&gt;POST /auth/login&lt;br&gt;GET /auth/profile&lt;br&gt;JWT token issuing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="370" y="575" width="155" height="120" as="geometry"/>
        </mxCell>

        <!-- Game Catalog Service -->
        <mxCell id="svc-games" value="&lt;b&gt;Game Catalog Service&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GET /games (list, search, filter)&lt;br&gt;GET /games/slug/:slug&lt;br&gt;POST /games (admin create)&lt;br&gt;PUT /games/:id (admin edit)&lt;br&gt;DELETE /games/:id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="545" y="575" width="185" height="120" as="geometry"/>
        </mxCell>

