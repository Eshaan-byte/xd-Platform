        <mxCell id="svc-upload" value="&lt;b&gt;Upload / Download Service&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /games/:id/upload&lt;br&gt;(admin — upload game files)&lt;br&gt;GET /games/:id/download&lt;br&gt;(user — signed URL)&lt;br&gt;Presigned S3 URLs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="750" y="575" width="185" height="120" as="geometry"/>
        </mxCell>

        <!-- Purchase Service -->
        <mxCell id="svc-purchase" value="&lt;b&gt;Purchase Service&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /purchase&lt;br&gt;(create order)&lt;br&gt;GET /library&lt;br&gt;(user's purchased games)&lt;br&gt;Stripe integration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="955" y="575" width="155" height="120" as="geometry"/>
        </mxCell>

        <!-- Middleware label -->
        <mxCell id="middleware" value="Middleware: JWT Auth · Rate Limiting · CORS · Helmet · Logging (Pino)" style="text;html=1;fontSize=10;align=center;fillColor=#e6e6e6;strokeColor=#999;rounded=1;fontColor=#555;" vertex="1" parent="1">
          <mxGeometry x="460" y="698" width="660" height="22" as="geometry"/>
        </mxCell>

