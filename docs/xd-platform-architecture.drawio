          <mxGeometry x="340" y="780" width="900" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="data-title" value="&lt;b&gt;Data &amp; Storage Layer&lt;/b&gt;" style="text;html=1;fontSize=14;align=center;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#8a6d0b;" vertex="1" parent="1">
          <mxGeometry x="660" y="785" width="260" height="25" as="geometry"/>
        </mxCell>

        <!-- MongoDB Atlas -->
        <mxCell id="mongodb" value="&lt;b&gt;MongoDB Atlas&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Collections:&lt;br&gt;• users&lt;br&gt;• games (metadata, tags, prices)&lt;br&gt;• orders / purchases&lt;br&gt;• community posts&lt;br&gt;&lt;br&gt;Mongoose ODM&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="420" y="815" width="200" height="115" as="geometry"/>
        </mxCell>

        <!-- Cloud Storage -->
        <mxCell id="s3" value="&lt;b&gt;Cloud Storage&lt;/b&gt;&lt;br&gt;(GCS / AWS S3)&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Buckets:&lt;br&gt;• game-files/ (ZIP/HTML)&lt;br&gt;• game-covers/ (images)&lt;br&gt;• game-screenshots/&lt;br&gt;&lt;br&gt;Presigned download URLs&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="690" y="815" width="200" height="115" as="geometry"/>
        </mxCell>

        <!-- Payment -->
        <mxCell id="stripe" value="&lt;b&gt;Payment Gateway&lt;/b&gt;&lt;br&gt;(Stripe)&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Checkout sessions&lt;br&gt;• Webhooks&lt;br&gt;• Refunds&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="960" y="815" width="200" height="115" as="geometry"/>
        </mxCell>

        <!-- ==================== CI/CD (Bottom) ==================== -->

        <mxCell id="cicd-box" value="" style="rounded=1;whiteSpace=wrap;fillColor=#fce4ec;strokeColor=#c62828;dashed=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="990" width="720" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cicd-label" value="&lt;b&gt;CI/CD Pipeline&lt;/b&gt;  —  GitHub Actions → Build → Test → Deploy to Cloud Run / Render" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="450" y="1000" width="680" height="50" as="geometry"/>
        </mxCell>

        <!-- ==================== ARROWS ==================== -->

        <!-- User → Frontend -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" source="user" target="frontend-box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a1-label" value="Browse, Search,&lt;br&gt;Purchase, Download" style="edgeLabel;html=1;fontSize=9;fillColor=none;fontColor=#6c8ebf;" vertex="1" connectable="0" parent="a1">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint x="65" y="-2" as="offset"/></mxGeometry>
        </mxCell>

        <!-- Admin → Admin Panel -->
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" source="admin" target="admin-box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a2-label" value="Upload Games,&lt;br&gt;Manage Catalog" style="edgeLabel;html=1;fontSize=9;fillColor=none;fontColor=#d6b656;" vertex="1" connectable="0" parent="a2">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint x="65" y="-2" as="offset"/></mxGeometry>
        </mxCell>

        <!-- Frontend → Gateway -->
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" source="frontend-box" target="gateway" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a3-label" value="REST API calls&lt;br&gt;(HTTPS + JWT)" style="edgeLabel;html=1;fontSize=9;fillColor=none;fontColor=#9673a6;" vertex="1" connectable="0" parent="a3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Admin Panel → Gateway -->
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" source="admin-box" target="gateway" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a4-label" value="REST API calls&lt;br&gt;(HTTPS + JWT admin)" style="edgeLabel;html=1;fontSize=9;fillColor=none;fontColor=#9673a6;" vertex="1" connectable="0" parent="a4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Gateway → Backend -->
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;" edge="1" source="gateway" target="backend-box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a5-label" value="Route to services" style="edgeLabel;html=1;fontSize=9;fillColor=none;fontColor=#82b366;" vertex="1" connectable="0" parent="a5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Auth → MongoDB -->
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=1.5;dashed=0;" edge="1" source="svc-auth" target="mongodb" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Games → MongoDB -->
        <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" source="svc-games" target="mongodb" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Upload → S3 -->
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" source="svc-upload" target="s3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Purchase → Stripe -->
        <mxCell id="a9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" source="svc-purchase" target="stripe" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Purchase → MongoDB -->
        <mxCell id="a10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;" edge="1" source="svc-purchase" target="mongodb" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1032" y="760"/>
              <mxPoint x="520" y="760"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Upload → MongoDB (metadata) -->
        <mxCell id="a11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;" edge="1" source="svc-upload" target="mongodb" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="842" y="745"/>
              <mxPoint x="520" y="745"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- GitHub → CI/CD -->
        <mxCell id="github" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;Eshaan-byte/xd-Platform" style="shape=mxgraph.basic.rounded_frame;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="140" y="995" width="200" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="a12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#c62828;strokeWidth=1.5;" edge="1" source="github" target="cicd-box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a12-label" value="git push → triggers" style="edgeLabel;html=1;fontSize=9;fillColor=none;fontColor=#c62828;" vertex="1" connectable="0" parent="a12">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== FLOW ANNOTATIONS ==================== -->

        <!-- Upload Flow -->
        <mxCell id="flow1" value="&lt;b&gt;Upload Flow:&lt;/b&gt;&lt;br&gt;1. Admin uploads game file (ZIP/HTML)&lt;br&gt;2. Backend gets presigned S3 URL&lt;br&gt;3. File uploaded directly to Cloud Storage&lt;br&gt;4. Game metadata saved to MongoDB" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=#e8f5e9;strokeColor=#a5d6a7;rounded=1;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="430" width="260" height="80" as="geometry"/>
        </mxCell>

        <!-- Download Flow -->
        <mxCell id="flow2" value="&lt;b&gt;Download Flow:&lt;/b&gt;&lt;br&gt;1. User purchases game (Stripe checkout)&lt;br&gt;2. Order saved to MongoDB&lt;br&gt;3. User requests download&lt;br&gt;4. Backend verifies purchase &amp; returns&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;presigned S3 download URL (expires)" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=#e3f2fd;strokeColor=#90caf9;rounded=1;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="530" width="280" height="95" as="geometry"/>
        </mxCell>

        <!-- Auth Flow -->
        <mxCell id="flow3" value="&lt;b&gt;Auth Flow:&lt;/b&gt;&lt;br&gt;1. User registers (email + password)&lt;br&gt;2. Password hashed with bcrypt&lt;br&gt;3. JWT token issued on login&lt;br&gt;4. Token sent in Authorization header&lt;br&gt;5. Admin role check for admin routes" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=#fce4ec;strokeColor=#ef9a9a;rounded=1;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="645" width="260" height="95" as="geometry"/>
        </mxCell>

      </root>
